# Copy to .env (never commit it). Every setting has a default.
PORT=8080
# 0.0.0.0 when the server faces the network directly or runs in a container; 127.0.0.1 behind a proxy on the same machine.
HOST=0.0.0.0
# 1 when a proxy (Caddy, nginx, Fly, Render) sits in front and sets X-Forwarded-For; 0 when visitors connect directly.
TRUST_PROXY=1
# Where the database and backups live. Put it on a persistent disk.
DATA_DIR=data
# A long random string. Left empty, one is made on first start and kept in DATA_DIR/.admin-token.
ADMIN_TOKEN=
# A page or address the sites we read can use to reach you; it goes in the scraper's User-Agent.
CONTACT_URL=https://free.food/about
# Leave at 1: skip anything a site's robots.txt asks bots not to read.
RESPECT_ROBOTS=1
# Who may frame the site, e.g. 'self' https://decks.example.com ; empty sends no rule.
FRAME_ANCESTORS='self'
# Other sites allowed to post votes and suggestions (comma-separated origins); normally empty.
ALLOWED_ORIGINS=
REFRESH_HOURS=3
BACKUP_DAYS=7
